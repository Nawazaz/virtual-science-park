# Copy this file to .env.local and fill in the values (.env.local is never committed).
# See LOCAL.md for where to find each value.

# --- Your own Supabase project (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF
SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# --- Local AI with Ollama ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
# Characters of each web page the local model reads (the quote check still uses the full page)
LOCAL_PAGE_CHARS=6000
# Opportunities ranked per AI call
LOCAL_MATCH_BATCH=6
# Requests the dispatcher sends to Ollama at once (match OLLAMA_NUM_PARALLEL if you raise it)
LOCAL_AI_SLOTS=1
# Longest reply per call: chat (Guard, Assistant) and background (Profiler, Matcher)
LOCAL_CHAT_MAX_TOKENS=600
LOCAL_MAX_TOKENS=2500

# --- Simulated sign-in: any long random text keeps sign-ins across restarts ---
SESSION_SECRET=

# --- Address of the local app, used by `npm run nightly:local` ---
APP_URL=http://localhost:8080
